# Copy this file to .env and fill in the real values (they are the same
# Supabase values as the web app's .env.local).
#
# EXPO_PUBLIC_ prefix = bundled into the app, so ONLY public-safe values may
# go here (Supabase URL + anon key + the API base URL). NEVER put
# SUPABASE_SERVICE_ROLE_KEY or RESEND_API_KEY in a mobile .env file.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
EXPO_PUBLIC_API_BASE_URL=https://your-app.vercel.app
